          faqTitle: 'Sıkça sorulan sorular',
          faqSubtitle: 'KKTC’de araç kullanmadan ve rota oluşturmadan önce gezginlerin sorduğu her şey.',
          faq1Q: 'Kuzey Kıbrıs’ta araç kullanmak için uluslararası ehliyete ihtiyacım var mı?',
          faq1A: 'Çoğu ziyaretçi kısa süreli konaklamalarda kendi ülke ehliyetiyle araç kullanabilir; ehliyetiniz Latin alfabesiyle değilse Uluslararası Sürücü Belgesi önerilir.',
          faq2Q: 'KKTC’de yolun hangi tarafından araç kullanılır?',
          faq2A: 'Kuzey Kıbrıs’ta, İngiltere ve Kıbrıs Cumhuriyeti’nde olduğu gibi soldan trafik uygulanır.',
          faq3Q: 'Karpaz Yarımadası rotası ne kadar sürer?',
          faq3A: 'Karpaz Yarımadası rotası, Altın Plaj duraklarıyla birlikte yaklaşık 5–6 saat süren tam günlük bir gezidir.',
          faq4Q: 'Rotalar çocuklu aileler için uygun mu?',
          faq4A: 'Evet — Girne Limanı ve Bellapais Köyü gibi kolay zorluktaki rotaları görmek için Aile filtresini kullanın.',
          faq5Q: 'Rota sayfaları Google Haritalar’da gerçek zamanlı trafik gösteriyor mu?',
          faq5A: 'Her rota, gerçek zamanlı yön ve trafik için doğrudan açabileceğiniz canlı bir Google Haritası içerir.',
          blogTitle: 'Seyahat ipuçları blogu',
          blogSubtitle: 'Daha akıllı bir Kuzey Kıbrıs rotası planlamanıza yardımcı olacak kısa yazılar.',
          blog1Title: 'KKTC’nin kıyı yollarında araç kullanmak için 5 ipucu',
          blog1Text: 'Yakıt duraklarından manzaralı mola noktalarına, Girne’nin kıyı sürüşünden en iyi şekilde yararlanmanın yolları.',
          blog2Title: 'Karpaz Altın Plaj’ı ziyaret etmek için günün en iyi saati',
          blog2Text: 'Öğlen sıcağından kaçının ve bu basit zamanlama rehberiyle yabani eşekleri yakalayın.',
          blog3Title: 'Bellapais köyü için yarım günlük bir program',
          blog3Text: 'Manastır ziyaretini doğru kafe durağı ve manzara noktasıyla eşleştirerek rahat bir yarım gün geçirin.',
          blogReadMore: 'Devamını oku →',
          safetyTitle: 'Acil durum numaraları ve güvenlik ipuçları',
          safetySubtitle: 'Herhangi bir Kuzey Kıbrıs rotasına çıkmadan önce bu numaraları hazır bulundurun.',
          emPolice: 'Polis',
          emAmbulance: 'Ambulans',
          emFire: 'İtfaiye',
          emCoastguard: 'Sahil Güvenlik',
          safety1: 'Sinyalin zayıf olduğu bölgelerde rotanızın basılı veya çevrimdışı bir kopyasını taşıyın.',
          safety2: 'Karpaz gibi kırsal rotalardan önce yakıt doldurun — istasyonlar arası mesafe daha fazladır.',
          safety3: 'Yollarda soldan trafik uygulanır; sağdan sürüşe alışkınsanız kavşaklarda dikkatli olun.',
          safety4: 'Kış aylarında kıyı veya tepe rotalarından önce yukarıdaki hava durumu kartına bakın.',
        }
      };

      const media = document.querySelectorAll('[data-i18n]');
      const langToggle = document.getElementById('langToggle');
      const filterButtons = document.querySelectorAll('.filter-button');
      const routeCards = document.querySelectorAll('.route-card');
      const heroPlanButton = document.getElementById('heroPlanButton');
      const heroDuration = document.getElementById('heroDuration');
      const heroCompanion = document.getElementById('heroCompanion');
      const heroMood = document.getElementById('heroMood');
      const heroPlanSummary = document.getElementById('heroPlanSummary');
      const backToTop = document.querySelector('.back-to-top');
      let currentLang = 'en';

      function translatePage(lang) {
        currentLang = lang;
        document.documentElement.lang = lang;
        media.forEach((el) => {
          const key = el.dataset.i18n;
          if (translations[lang][key]) {
            el.textContent = translations[lang][key];
          }
        });
        langToggle.textContent = lang === 'tr' ? 'EN' : 'TR';
        updatePlanSummary();
      }

      langToggle.addEventListener('click', () => translatePage(currentLang === 'en' ? 'tr' : 'en'));

      const distanceFilter = document.getElementById('distanceFilter');
      const difficultyFilter = document.getElementById('difficultyFilter');
      let activeCategory = 'all';

      function applyFilters() {
        const distanceValue = distanceFilter ? distanceFilter.value : 'all';
        const difficultyValue = difficultyFilter ? difficultyFilter.value : 'all';
        routeCards.forEach((card) => {
          const category = card.dataset.category;
          const distance = card.dataset.distance;
          const difficulty = card.dataset.difficulty;
          const matchesCategory = activeCategory === 'all' || activeCategory === category;
          const matchesDistance = distanceValue === 'all' || distanceValue === distance;
          const matchesDifficulty = difficultyValue === 'all' || difficultyValue === difficulty;
          card.style.display = matchesCategory && matchesDistance && matchesDifficulty ? 'block' : 'none';
        });
      }

      filterButtons.forEach((button) => {
        button.addEventListener('click', () => {
          filterButtons.forEach((btn) => btn.classList.remove('active'));
          button.classList.add('active');
          activeCategory = button.dataset.filter;
          applyFilters();
        });
      });
      if (distanceFilter) distanceFilter.addEventListener('change', applyFilters);
      if (difficultyFilter) difficultyFilter.addEventListener('change', applyFilters);

      // ---- Campus card: open EUL location in Google Maps ----
      const campusBtn = document.querySelector('.campus-directions-btn');
      if (campusBtn) {
        campusBtn.addEventListener('click', () => {
          const query = encodeURIComponent(campusBtn.dataset.query);
          window.open(`https://www.google.com/maps/search/${query}`, '_blank', 'noopener');
        });
      }

      // ---- Expert route cards: open Google Maps search or multi-stop directions ----
      document.querySelectorAll('.expert-route').forEach((card) => {
        card.addEventListener('click', () => {
          if (card.dataset.origin && card.dataset.destination) {
            const origin = encodeURIComponent(card.dataset.origin);
            const destination = encodeURIComponent(card.dataset.destination);
            let url = `https://www.google.com/maps/dir/?api=1&origin=${origin}&destination=${destination}`;
            if (card.dataset.waypoints) {
              const waypoints = card.dataset.waypoints.split('|').map((w) => encodeURIComponent(w.trim())).join('|');
              url += `&waypoints=${waypoints}`;
            }
            window.open(url, '_blank', 'noopener');
          } else if (card.dataset.query) {
            const query = encodeURIComponent(card.dataset.query);
            window.open(`https://www.google.com/maps/search/${query}`, '_blank', 'noopener');
          }
        });
      });

      // ---- Route map toggle (Google Maps per route, loaded on demand for performance) ----
      document.querySelectorAll('.map-toggle-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const wrap = btn.nextElementSibling;
          const isHidden = wrap.hasAttribute('hidden');
          if (isHidden) {
            if (!wrap.dataset.loaded) {
              const query = encodeURIComponent(btn.dataset.query);
              const iframe = document.createElement('iframe');
              iframe.loading = 'lazy';
              iframe.title = btn.dataset.query;
              iframe.src = `https://www.google.com/maps?q=${query}&z=13&output=embed`;
              wrap.appendChild(iframe);
              wrap.dataset.loaded = 'true';
            }
            wrap.removeAttribute('hidden');
          } else {
            wrap.setAttribute('hidden', '');
          }
        });
      });

      // ---- Star rating widget (visual, persisted per browser) ----
      document.querySelectorAll('.stars-input').forEach((widget) => {
        const routeId = widget.dataset.route;
        const stars = Array.from(widget.querySelectorAll('span'));
        const storeKey = `northroute-rating-${routeId}`;
        const saved = Number(localStorage.getItem(storeKey) || 0);
        function paint(value) {
          stars.forEach((s) => s.classList.toggle('filled', Number(s.dataset.star) <= value));
        }
        paint(saved);
        stars.forEach((s) => {
          s.addEventListener('click', () => {
            const value = Number(s.dataset.star);
            localStorage.setItem(storeKey, String(value));
            paint(value);
          });
          s.addEventListener('mouseenter', () => {
            stars.forEach((st) => st.classList.toggle('hovered', Number(st.dataset.star) <= Number(s.dataset.star)));
          });
          s.addEventListener('mouseleave', () => stars.forEach((st) => st.classList.remove('hovered')));
        });
      });

      // ---- Social share buttons ----
      document.querySelectorAll('.share-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const pageUrl = encodeURIComponent(window.location.href);
          const text = encodeURIComponent(btn.dataset.title || document.title);
          const network = btn.dataset.network;
          let shareUrl = '';
          if (network === 'facebook') shareUrl = `https://www.facebook.com/sharer/sharer.php?u=${pageUrl}`;
          if (network === 'twitter') shareUrl = `https://twitter.com/intent/tweet?url=${pageUrl}&text=${text}`;
          if (network === 'whatsapp') shareUrl = `https://wa.me/?text=${text}%20${pageUrl}`;
          if (shareUrl) window.open(shareUrl, '_blank', 'noopener,width=600,height=500');
        });
      });

      // ---- Weather (Open-Meteo, no API key required) ----
      document.querySelectorAll('.weather-card').forEach(async (card) => {
        const lat = card.dataset.lat;
        const lon = card.dataset.lon;
        try {
          const res = await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current_weather=true`);
          const data = await res.json();
          const temp = Math.round(data.current_weather.temperature);
          const wind = Math.round(data.current_weather.windspeed);
          card.querySelector('.weather-temp').textContent = `${temp}°C`;
          const descEl = card.querySelector('.weather-desc');
          descEl.textContent = currentLang === 'tr' ? `Rüzgar ${wind} km/sa` : `Wind ${wind} km/h`;
          descEl.removeAttribute('data-i18n');
        } catch (err) {
          const descEl = card.querySelector('.weather-desc');
          descEl.textContent = currentLang === 'tr' ? 'Hava durumu şu an alınamıyor' : 'Weather unavailable right now';
          descEl.removeAttribute('data-i18n');
        }
      });

      function updatePlanSummary() {
        const duration = heroDuration.value;
        const companion = heroCompanion.value;
        const mood = heroMood.value;
        let summary = '';

        const mapEn = {
          family: 'A family-friendly route.',
          teens: 'An energetic day for teens.',
          couple: 'A romantic escape for couples.',
          nature: 'A refreshing route full of nature.'
        };
        const mapTr = {
          family: 'Aile dostu bir rota.',
          teens: 'Gençler için enerjik bir gün.',
          couple: 'Çiftler için romantik bir kaçış.',
          nature: 'Doğa dolu ferah bir rota.'
        };
        const moodEn = {
          beach: 'Beach stops and golden sunsets.',
          culture: 'History, villages and cultural gems.',
          food: 'Local food and nightlife highlights.',
          adventure: 'Water sports and active seaside fun.'
        };
        const moodTr = {
          beach: 'Plaj durakları ve altın gün batımları.',
          culture: 'Tarih, köyler ve kültürel duraklar.',
          food: 'Yerel lezzetler ve gece hayatı.',
          adventure: 'Su sporları ve aktif kıyı keyfi.'
        };
        const lengthEn = {
          halfday: 'Perfect for a half day.',
          fullday: 'Balanced for a full day.',
          weekend: 'Ideal for a weekend adventure.'
        };
        const lengthTr = {
          halfday: 'Yarım gün için ideal.',
          fullday: 'Tam gün için dengeli.',
          weekend: 'Hafta sonu macerası için uygun.'
        };

        if (currentLang === 'tr') {
          summary = `${mapTr[companion]} ${moodTr[mood]} ${lengthTr[duration]}`;
        } else {
          summary = `${mapEn[companion]} ${moodEn[mood]} ${lengthEn[duration]}`;
        }

        heroPlanSummary.textContent = summary;
      }

      heroPlanButton.addEventListener('click', () => {
        updatePlanSummary();
        const original = translations[currentLang].planButton;
        heroPlanButton.textContent = currentLang === 'tr' ? 'Güncellendi ✓' : 'Updated ✓';
        setTimeout(() => { heroPlanButton.textContent = original; }, 1400);
      });

      document.querySelectorAll('#heroDuration, #heroCompanion, #heroMood').forEach((el) => {
        el.addEventListener('change', updatePlanSummary);
      });

      window.addEventListener('scroll', () => {
        backToTop.classList.toggle('show', window.scrollY > 500);
      });
      backToTop.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));

      const topSearchForm = document.getElementById('topSearchForm');
      const topSearchInput = document.getElementById('topSearchInput');
      const searchSummary = document.getElementById('searchSummary');

      topSearchForm.addEventListener('submit', (event) => {
        event.preventDefault();
        const query = topSearchInput.value.trim();
        if (!query) {
          searchSummary.textContent = 'Please type a place, landmark, or city to search on Google Maps.';
          return;
        }
        const mapsQuery = encodeURIComponent(query);
        const mapsUrl = `https://www.google.com/maps/search/${mapsQuery}`;
        searchSummary.textContent = `Searching for “${query}” in Google Maps...`; 
        window.open(mapsUrl, '_blank', 'noopener');
      });

      translatePage('en');
      updatePlanSummary();
    </script>
  </body>
</html>
